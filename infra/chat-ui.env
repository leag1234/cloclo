# Public Open WebUI settings; provider credentials are never passed here.
HOST=127.0.0.1
PORT=3000
WEBUI_AUTH=False
ENABLE_OLLAMA_API=False
ENABLE_EVALUATION_ARENA_MODELS=True
ENABLE_AUTOCOMPLETE_GENERATION=True
ENABLE_DIRECT_CONNECTIONS=False
ENABLE_COMMUNITY_SHARING=False
ENABLE_CODE_EXECUTION=True
ENABLE_CODE_INTERPRETER=True
ENABLE_TITLE_GENERATION=True
ENABLE_TAGS_GENERATION=True
ENABLE_FOLLOW_UP_GENERATION=True
ENABLE_PERSISTENT_CONFIG=True
OPENAI_API_BASE_URL=http://127.0.0.1:8020/v1
OPENAI_API_KEY=atlas-local
HF_HUB_OFFLINE=1
RAG_EMBEDDING_MODEL_AUTO_UPDATE=False
DO_NOT_TRACK=true
SCARF_NO_ANALYTICS=true
# NOTE: code execution/interpreter activés — l'UI est en accès LOCAL uniquement
# (tunnel SSH, mono-utilisateur). À revoir impérativement avant toute exposition.
# DIRECT_CONNECTIONS et COMMUNITY_SHARING restent désactivés (contournement du
# gateway et partage externe de prompts).
